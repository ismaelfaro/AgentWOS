package agentwos:core@0.1.0;

// Single contract for the whole system. The host and every module generate
// their bindings from this file; each module picks one `world`.

interface types {
    record message {
        role: string,
        content: string,
    }

    record tool-call {
        name: string,
        args-json: string,
    }

    variant call-error {
        invalid-input(string),
        execution-failed(string),
        not-found(string),
    }
}

interface tool {
    use types.{tool-call, call-error};

    /// JSON with name, description and json_schema.
    describe: func() -> string;
    invoke: func(call: tool-call) -> result<string, call-error>;
}

interface llm {
    use types.{message, call-error};

    /// model: "openrouter/<id>" or "local/<id>".
    complete: func(messages: list<message>, model: string) -> result<string, call-error>;
}

/// Host-mediated files and processes for plugin agents. Paths are relative to
/// the harness workspace, and a program runs only if the host allowlists it.
interface workspace {
    use types.{call-error};

    record file-entry {
        path: string,
        kind: string,
        bytes: u64,
    }

    record exec-result {
        status: s32,
        stdout: string,
        stderr: string,
    }

    read: func(path: string) -> result<string, call-error>;
    write: func(path: string, contents: string) -> result<string, call-error>;
    list-files: func(path: string) -> result<list<file-entry>, call-error>;
    exec: func(program: string, args: list<string>) -> result<exec-result, call-error>;
}

interface agent {
    use types.{message, call-error};

    run: func(input: list<message>) -> result<string, call-error>;
}

/// OS control modules: inspect every action before it is delivered.
/// `context` is scenario-defined JSON (for example, resource levels).
interface control {
    variant verdict {
        allow,
        modify(string),
        block(string),
        flag(string),
    }

    inspect: func(author: string, text: string, context: string) -> verdict;

    /// What this control is and what it enforces, as JSON with `title`,
    /// `role` and `rules` (a list of sentences), so a UI can show it.
    describe: func() -> string;
}

/// A scenario owns the world: agents, rules, state and the record of what
/// happened. The kernel only drives turns and calls controls in between.
interface scenario {
    use types.{message};

    /// config: JSON with at least `model` and `days`. Returns JSON with
    /// `agents` (names and roles) and any extra fields the dashboard reads.
    setup: func(config: string) -> string;
    /// Starts a day. Returns a short description of the day.
    begin-day: func(day: u32, total: u32) -> string;
    /// Messages the agent at index `agent` receives for its turn.
    turn-messages: func(agent: u32) -> list<message>;
    /// Extracts the action text from the raw model reply.
    action-of: func(agent: u32, reply: string) -> string;
    /// JSON context passed to every control for this turn.
    context: func() -> string;
    /// Records the outcome of a turn. `delivered` is none when a control blocked it.
    /// `controls` is a JSON array of control verdicts.
    record-turn: func(agent: u32, delivered: option<string>, controls: string, latency-ms: u64, error: option<string>);
    /// Closes the day. Returns true when the simulation has collapsed.
    end-day: func() -> bool;
    /// JSON array with every day recorded so far.
    snapshot: func() -> string;
}

/// Tool-calling LLM service: maps one instruction to tool calls.
/// `tools-json` is an array of OpenAI-style function declarations. The result
/// is JSON with `function_calls` (array of {name, arguments}) and `confidence`.
interface tool-llm {
    use types.{call-error};

    call: func(system: string, tools-json: string, input: string) -> result<string, call-error>;
}

/// An agent that acts only through tool calls.
interface actor {
    use types.{call-error};

    /// brief: JSON {system, tools, aliases, min_confidence?} from the stage.
    /// Returns a JSON array of attempts: {clause, confidence, calls, ignored}.
    act: func(brief: string, input: string) -> result<string, call-error>;
}

/// An interactive scenario: agents change shared state through tool calls,
/// and the stage renders that state tick by tick.
interface stage {
    /// Returns JSON with `agents` ({agent, role}) and any extra fields for the UI.
    setup: func(config: string) -> string;
    /// JSON brief for the agent at index `agent` (see `actor.act`).
    brief: func(agent: u32) -> string;
    /// JSON context passed to every control.
    context: func() -> string;
    /// Applies one tool call ({name, arguments} JSON). Returns a short
    /// description, or an error when the call is invalid.
    apply: func(agent: u32, call: string) -> result<string, string>;
    /// Adds an agent of the given kind while running. Returns JSON with its
    /// `index`, `agent`, `role` and optional `pad`, or an error when the stage
    /// cannot take another one.
    spawn: func(kind: string) -> result<string, string>;
    /// Scenario-defined JSON output for one tick (for example, the notes of a bar).
    render: func(tick: u32) -> string;
    /// Current state as JSON.
    state: func() -> string;
}

world agent-module {
    import llm;
    import tool;
    export agent;
}

/// A plugin agent for a harness: message in, text out. A plugin may import
/// `llm` and `workspace`, but each one only works when the harness manifest
/// grants it to that plugin; otherwise the call returns an error. A plugin
/// never gets `wasi:http`, the filesystem or processes directly.
/// Asking several agents at the same time.
interface team {
    use types.{tool-call, call-error};

    /// Each call goes to its own instance of the named agent. The answers
    /// come back in the order of the calls.
    invoke-all: func(calls: list<tool-call>) -> list<result<string, call-error>>;
}

world plugin-module {
    import llm;
    import workspace;
    import tool;
    import team;
    export agent;
}

world tool-module {
    export tool;
}

world llm-module {
    export llm;
}

world control-module {
    export control;
}

world scenario-module {
    export scenario;
}

world actor-module {
    import tool-llm;
    export actor;
}

world stage-module {
    export stage;
}
