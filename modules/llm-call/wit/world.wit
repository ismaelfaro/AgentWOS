package agentmodules:core@0.1.0;

interface types {
    record message {
        role: string,
        content: string,
    }

    variant call-error {
        invalid-input(string),
        execution-failed(string),
        not-found(string),
    }
}

interface llm {
    use types.{message, call-error};

    complete: func(messages: list<message>, model: string) -> result<string, call-error>;
}

// v1: sin wasi:http todavia (requiere cargo-component para resolver deps WIT
// de wasi:http automaticamente). Stub determinista para validar el pipeline
// completo host <-> agent-core <-> tool/llm. Fase siguiente: anadir
// `include wasi:cli/imports@0.2.0;` + llamada real a OpenRouter/Ollama.
world llm-module {
    export llm;
}
