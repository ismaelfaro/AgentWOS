package agentwos:core@0.1.0;

// Single contract for the whole system. The host and every module generate
// their bindings from this file; each module picks one `world`.

interface types {
    record message {
        role: string,
        content: string,
    }

    record tool-call {
        name: string,
        args-json: string,
    }

    variant call-error {
        invalid-input(string),
        execution-failed(string),
        not-found(string),
    }
}

interface tool {
    use types.{tool-call, call-error};

    /// JSON with name, description and json_schema.
    describe: func() -> string;
    invoke: func(call: tool-call) -> result<string, call-error>;
}

interface llm {
    use types.{message, call-error};

    /// model: "openrouter/<id>" or "local/<id>".
    complete: func(messages: list<message>, model: string) -> result<string, call-error>;
}

/// Host-mediated files and processes for plugin agents. Paths are relative to
/// the harness workspace, and a program runs only if the host allowlists it.
interface workspace {
    use types.{call-error};

    record file-entry {
        path: string,
        kind: string,
        bytes: u64,
    }

    record exec-result {
        status: s32,
        stdout: string,
        stderr: string,
    }

    read: func(path: string) -> result<string, call-error>;
    write: func(path: string, contents: string) -> result<string, call-error>;
    list-files: func(path: string) -> result<list<file-entry>, call-error>;
    exec: func(program: string, args: list<string>) -> result<exec-result, call-error>;
}

interface agent {
    use types.{message, call-error};

    run: func(input: list<message>) -> result<string, call-error>;
}

/// OS control modules: inspect every action before it is delivered.
/// `context` is scenario-defined JSON (for example, resource levels).
interface control {
    variant verdict {
        allow,
        modify(string),
        block(string),
        flag(string),
    }

    inspect: func(author: string, text: string, context: string) -> verdict;

    /// What this control is and what it enforces, as JSON with `title`,
    /// `role` and `rules` (a list of sentences), so a UI can show it.
    describe: func() -> string;
}

/// A scenario owns the world: agents, rules, state and the record of what
/// happened. The kernel only drives turns and calls controls in between.
interface scenario {
    use types.{message};

    /// config: JSON with at least `model` and `days`. Returns JSON with
    /// `agents` (names and roles) and any extra fields the dashboard reads.
    setup: func(config: string) -> string;
    /// Starts a day. Returns a short description of the day.
    begin-day: func(day: u32, total: u32) -> string;
    /// Messages the agent at index `agent` receives for its turn.
    turn-messages: func(agent: u32) -> list<message>;
    /// Extracts the action text from the raw model reply.
    action-of: func(agent: u32, reply: string) -> string;
    /// JSON context passed to every control for this turn.
    context: func() -> string;
    /// Records the outcome of a turn. `delivered` is none when a control blocked it.
    /// `controls` is a JSON array of control verdicts.
    record-turn: func(agent: u32, delivered: option<string>, controls: string, latency-ms: u64, error: option<string>);
    /// Closes the day. Returns true when the simulation has collapsed.
    end-day: func() -> bool;
    /// JSON array with every day recorded so far.
    snapshot: func() -> string;
}

/// Tool-calling LLM service: maps one instruction to tool calls.
/// `tools-json` is an array of OpenAI-style function declarations. The result
/// is JSON with `function_calls` (array of {name, arguments}) and `confidence`.
interface tool-llm {
    use types.{call-error};

    call: func(system: string, tools-json: string, input: string) -> result<string, call-error>;
}

/// An agent that acts only through tool calls.
interface actor {
    use types.{call-error};

    /// brief: JSON {system, tools, aliases, min_confidence?} from the stage.
    /// Returns a JSON array of attempts: {clause, confidence, calls, ignored}.
    act: func(brief: string, input: string) -> result<string, call-error>;
}

/// An interactive scenario: agents change shared state through tool calls,
/// and the stage renders that state tick by tick.
interface stage {
    /// Returns JSON with `agents` ({agent, role}) and any extra fields for the UI.
    setup: func(config: string) -> string;
    /// JSON brief for the agent at index `agent` (see `actor.act`).
    brief: func(agent: u32) -> string;
    /// JSON context passed to every control.
    context: func() -> string;
    /// Applies one tool call ({name, arguments} JSON). Returns a short
    /// description, or an error when the call is invalid.
    apply: func(agent: u32, call: string) -> result<string, string>;
    /// Adds an agent of the given kind while running. Returns JSON with its
    /// `index`, `agent`, `role` and optional `pad`, or an error when the stage
    /// cannot take another one.
    spawn: func(kind: string) -> result<string, string>;
    /// Scenario-defined JSON output for one tick (for example, the notes of a bar).
    render: func(tick: u32) -> string;
    /// Current state as JSON.
    state: func() -> string;
}

world agent-module {
    import llm;
    import tool;
    export agent;
}

/// A plugin agent for a harness: message in, text out. A plugin may import
/// `llm` and `workspace`, but each one only works when the harness manifest
/// grants it to that plugin; otherwise the call returns an error. A plugin
/// never gets `wasi:http`, the filesystem or processes directly.
/// Asking several agents at the same time.
interface team {
    use types.{tool-call, call-error};

    /// Each call goes to its own instance of the named agent. The answers
    /// come back in the order of the calls.
    invoke-all: func(calls: list<tool-call>) -> list<result<string, call-error>>;
}

world plugin-module {
    import llm;
    import workspace;
    import tool;
    import team;
    export agent;
}

world tool-module {
    export tool;
}

world llm-module {
    export llm;
}

world control-module {
    export control;
}

world scenario-module {
    export scenario;
}

world actor-module {
    import tool-llm;
    export actor;
}

world stage-module {
    export stage;
}

/// MCP bridge to one outside server. One instance per server, with network
/// access only to that server's host. `server` is JSON:
/// `{"url": "...", "era": "current" | "legacy"}`; `era` may be omitted for `probe`.
interface mcp-client {
    use types.{call-error};

    /// Asks the server which protocol it speaks: returns "current" or "legacy".
    probe: func(server: string) -> result<string, call-error>;
    /// The raw `result` of `tools/list`, as JSON.
    list-tools: func(server: string) -> result<string, call-error>;
    /// The raw `result` of `tools/call`, as JSON.
    call-tool: func(server: string, name: string, arguments: string) -> result<string, call-error>;
}

/// An outside MCP client calling agents of this system. It is stateless: each
/// message stands alone.
interface mcp-server {
    /// One JSON-RPC message from the client. Returns the reply, when it needs one.
    handle: func(message: string) -> option<string>;
}

/// The agents offered to outside MCP clients. The host decides which, and runs
/// each call with the grants listed for exposure.
interface exposed {
    use types.{call-error};

    /// JSON array of MCP tool definitions, one per exposed agent.
    list-agents: func() -> string;
    call-agent: func(name: string, arguments: string) -> result<string, call-error>;
}

world mcp-client-module {
    export mcp-client;
}

world mcp-server-module {
    import exposed;
    export mcp-server;
}

/// A read-only window on what the kernel mediates. The kernel writes one event
/// for every call between agents, every model call, file and program, whether
/// or not anyone is looking; a component granted this can only read them. It
/// sees what happened and how long it took, never the agents' memory.
interface observe {
    record event {
        /// Counts up from 1 and never repeats, so a reader asks for "after N".
        seq: u64,
        /// Milliseconds since the kernel started.
        at-ms: u64,
        /// The agent the event is about.
        agent: string,
        /// Who asked it, for `start` and `end`; the agent itself otherwise.
        caller: string,
        /// `start`, `end`, `think`, `file` or `program`.
        kind: string,
        /// A short line: the input, the model, the path or the command.
        detail: string,
        /// How long it took, for `end`, `think` and `program`; 0 otherwise.
        ms: u64,
        ok: bool,
    }

    record agent-stat {
        name: string,
        /// How many calls to it are running right now.
        busy: u32,
        calls: u32,
        /// Failures: calls that returned an error, and model calls, files
        /// and programs that failed while the agent worked.
        errors: u32,
        thoughts: u32,
        files: u32,
        programs: u32,
        /// Time spent answering, summed over finished calls.
        total-ms: u64,
        /// When it last went from idle to busy; 0 while idle.
        busy-since-ms: u64,
        last-ms: u64,
        last: string,
    }

    /// One agent asking another: how many times, and how many are running now.
    /// `caller` is an agent, `router` for the agent that takes requests, `you`
    /// for the person at the prompt or `outside` for a caller on the network.
    record edge {
        caller: string,
        agent: string,
        calls: u32,
        busy: u32,
    }

    /// Milliseconds since the kernel started.
    now: func() -> u64;
    agents: func() -> list<agent-stat>;
    /// Every pair seen so far. Unlike events, these are never trimmed.
    edges: func() -> list<edge>;
    /// Events with `seq` greater than `after`, oldest first, at most `limit`.
    /// The kernel keeps the latest few thousand.
    events: func(after: u64, limit: u32) -> list<event>;
}

/// What a dashboard agent offers the kernel to show to people.
interface dashboard {
    /// JSON for the page: the clock, every agent with its state and alerts,
    /// the totals, and the events after `after`.
    snapshot: func(after: u64) -> string;
    /// The page itself, one HTML document that polls `snapshot`.
    page: func() -> string;
    /// Plain text for a terminal: all agents, or the one named.
    report: func(agent: option<string>) -> string;
}

world dashboard-module {
    import observe;
    export dashboard;
}
